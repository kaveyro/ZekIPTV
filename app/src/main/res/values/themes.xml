<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Vollbild, kein ActionBar; dunkles Basis-Theme (TV-Standard).
         Die eigentliche Farbgebung kommt aus Compose (IptvTheme). Der Fensterhintergrund
         entspricht dem App-Hintergrund, damit beim Start nichts andersfarbig aufblitzt. -->
    <style name="Theme.Iptv" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Startbildschirm-Varianten (Android 13+ per setSplashScreenTheme gewählt). -->
    <style name="Theme.Iptv.Light">
        <item name="android:windowBackground">@color/window_light</item>
    </style>

    <style name="Theme.Iptv.System">
        <item name="android:windowBackground">@color/window_system</item>
    </style>
</resources>
