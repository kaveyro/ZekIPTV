<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: weder Cloud-Backup noch Geräte-Übertragung — die Einstellungen enthalten
     Playlist-URLs mit Zugangsdaten. Gesichert wird über das eigene Backup in den Einstellungen. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
