<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Fire TV / Android TV: Leanback unterstützt, aber App läuft auch auf Handy/Tablet.
         Touchscreen nicht erforderlich (Fire TV hat keinen). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iptv"
        android:usesCleartextTraffic="true"><!-- Viele IPTV-Playlists/Streams laufen über unverschlüsseltes HTTP. -->
        <!-- Kein screenOrientation-Lock mehr: MainActivity erzwingt Querformat zur Laufzeit
             auf TV-Geräten; Handys dürfen rotieren. configChanges verhindert dabei die
             Activity-Neuerstellung — die Wiedergabe läuft bei Rotation unterbrechungsfrei. -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Startet auf Handy/Tablet ... -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- ... und im Fire-TV-/Android-TV-Startmenü. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
