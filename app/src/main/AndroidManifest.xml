<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+: Playlists/Streams im Heimnetz (Tvheadend, NAS …). Wird nur angefragt,
         wenn eine Playlist-, Stream- oder EPG-Adresse tatsächlich ins lokale Netz zeigt. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Updates aus GitHub-Releases installieren (Sideload-App ohne Play Store). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Fire TV / Android TV: Leanback unterstützt, aber App läuft auch auf Handy/Tablet.
         Touchscreen nicht erforderlich (Fire TV hat keinen). -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- allowBackup=false: Playlist-URLs enthalten Xtream-Zugangsdaten; Sicherung läuft über
         das eigene Backup in den Einstellungen. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iptv"
        android:usesCleartextTraffic="true"><!-- Viele IPTV-Playlists/Streams laufen über unverschlüsseltes HTTP. -->
        <!-- Kein screenOrientation-Lock mehr: MainActivity erzwingt Querformat zur Laufzeit
             auf TV-Geräten; Handys dürfen rotieren. configChanges verhindert dabei die
             Activity-Neuerstellung — die Wiedergabe läuft bei Rotation unterbrechungsfrei. -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Startet auf Handy/Tablet ... -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- ... und im Fire-TV-/Android-TV-Startmenü. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Gibt heruntergeladene Update-APKs an den System-Installer frei. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
